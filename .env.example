# Environment variables for Midscene Python
# Copy to .env and fill in your model credentials, then `set -a; source .env; set +a`.

# ---------------------------------------------------------------------------
# Default model (fallback for planning / locate / insight)
# ---------------------------------------------------------------------------
MIDSCENE_MODEL_NAME=doubao-seed-1-6-250515
MIDSCENE_MODEL_API_KEY=sk-...
MIDSCENE_MODEL_BASE_URL=https://ark.cn-beijing.volces.com/api/v3
# Required for locate coordinate parsing.
MIDSCENE_MODEL_FAMILY=doubao-seed

# Optional request settings
# MIDSCENE_MODEL_PROTOCOL=openai-chat          # openai-chat | openai-responses
# MIDSCENE_MODEL_STREAM_MODE=non-stream        # stream | non-stream
# MIDSCENE_MODEL_TIMEOUT=180                   # seconds
# MIDSCENE_MODEL_TEMPERATURE=0.1
# MIDSCENE_MODEL_RETRY_COUNT=1
# MIDSCENE_MODEL_RETRY_INTERVAL=2000           # milliseconds
# MIDSCENE_MODEL_AUTH_MODE=api-key             # api-key | siwc

# ---------------------------------------------------------------------------
# Dedicated model slots (optional; fall back to the default model)
# Each slot supports the same suffixes: _NAME, _API_KEY, _BASE_URL,
# _FAMILY, _PROTOCOL, _STREAM_MODE, _TIMEOUT, _TEMPERATURE,
# _RETRY_COUNT, _RETRY_INTERVAL, ...
# ---------------------------------------------------------------------------
# MIDSCENE_PLANNING_MODEL_NAME=
# MIDSCENE_PLANNING_MODEL_API_KEY=
# MIDSCENE_PLANNING_MODEL_BASE_URL=
# MIDSCENE_PLANNING_MODEL_FAMILY=

# MIDSCENE_LOCATE_MODEL_NAME=
# MIDSCENE_LOCATE_MODEL_API_KEY=
# MIDSCENE_LOCATE_MODEL_BASE_URL=
# MIDSCENE_LOCATE_MODEL_FAMILY=

# MIDSCENE_INSIGHT_MODEL_NAME=
# MIDSCENE_INSIGHT_MODEL_API_KEY=
# MIDSCENE_INSIGHT_MODEL_BASE_URL=
# MIDSCENE_INSIGHT_MODEL_FAMILY=

# ---------------------------------------------------------------------------
# Runtime
# ---------------------------------------------------------------------------
# Enable caching with the default cache id when the Agent has no cache_id.
# A cache_id on the Agent (or agent.cache in YAML) already enables caching.
# MIDSCENE_CACHE=1

# Root directory for cache/, report/ and output/ (default: ./midscene_run).
# MIDSCENE_RUN_DIR=./midscene_run

# Override the execution report tag (defaults to the interface type).
# MIDSCENE_REPORT_TAG_NAME=web

# Maximum planning loop iterations for aiAct (default: 20).
# MIDSCENE_REPLANNING_CYCLE_LIMIT=20

# Preferred response language for model prompts (Chinese / English).
# MIDSCENE_PREFERRED_LANGUAGE=English
